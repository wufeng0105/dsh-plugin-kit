{
  "name": "@wufeng0105/dsh-plugin-kit",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH 插件开发流程：同时提供判据（skill）、常驻纪律（systemPrompt 段）和强制力（未过门拦截）。装一个包，三样都有。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wufeng0105/dsh-plugin-kit.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "skill",
    "stage-gate",
    "reviewer"
  ],
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "vendor",
    "skills",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "evidence",
    "test/e2e",
    "CHANGELOG.md",
    "LOGGING.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/gate.test.mjs test/ledger.test.mjs test/skill-provider.test.mjs",
    "smoke": "node --test test/smoke.mjs",
    "mutate": "node test/mutate.mjs",
    "check": "node --check index.js && node --check lib/gate.js && node --check lib/ledger.js && node --check lib/skill-provider.js && node --check lib/discipline.js && npm test && npm run smoke && npm run mutate"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20.3.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  }
}
